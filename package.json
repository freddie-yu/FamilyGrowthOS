{
  "name": "family-growth-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.4",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "miniprogram",
    "server",
    "web-admin",
    "shared"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.cjs",
    "tokens:generate": "node scripts/generate-tokens.cjs",
    "tokens:check": "node scripts/generate-tokens.cjs --check",
    "dev:mini": "node scripts/run.cjs dev mini",
    "dev:server": "node scripts/run.cjs dev server",
    "dev:admin": "node scripts/run.cjs dev admin",
    "build:mini": "node scripts/run.cjs build mini",
    "build:server": "node scripts/run.cjs build server",
    "build:admin": "node scripts/run.cjs build admin",
    "build": "npm run tokens:check && npm run build:server && npm run build:admin && npm run build:mini",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:smoke": "node scripts/smoke.cjs",
    "verify": "npm run tokens:check && npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run test:smoke"
  },
  "overrides": {
    "schema-utils@^4.0.0": "4.3.2",
    "webpack@5.91.0": {
      "schema-utils": "3.3.0"
    }
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "yaml": "2.8.1",
    "vite": "6.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
